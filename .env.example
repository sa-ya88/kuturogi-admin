APP_NAME="KUTUROGI管理システム"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# ポートフォリオ公開用。ログイン案内とダミー入力の注意書きを有効化
DEMO_MODE=true
# スタッフ選択ログイン用のデモパスワード
DEMO_LOGIN_PASSWORD=demo
# デモデータの初期化間隔（時間）。cron で php artisan schedule:run が必要
DEMO_REFRESH_HOURS=4


APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# 顧客サイト kuturogi と同一ファイルを使う（マイグレーションは admin 側のみ）
# DB_DATABASE=/workspaces/kuturogi-admin/database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kuturogi_admin
# DB_USERNAME=root
# DB_PASSWORD=

# true のとき kuturogi と DB を共有し、API / Webhook 同期は送らない
SHARED_DATABASE=true
SESSION_COOKIE=kuturogi_admin_session

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# kuturogi 連携設定
# 同一コンテナ: http://localhost:8080
# 別コンテナ:   http://host.docker.internal:8080
KUTUROGI_BASE_URL=http://host.docker.internal:8080
KUTUROGI_API_KEY=
KUTUROGI_WEBHOOK_SECRET=
# Dev Container では未設定で ../kuturogi/public/images を参照
# KUTUROGI_PUBLIC_IMAGES_PATH=/workspaces/kuturogi/public/images

# kuturogi-admin が kuturogi から受信する Webhook の署名検証用
KUTUROGI_INBOUND_WEBHOOK_SECRET=

# Stripe（テストモードのキーのみ有効。sk_live_ / pk_live_ は拒否される）
# Dashboard → Developers → API keys（Test mode）
# テストカード: 4242 4242 4242 4242
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=
